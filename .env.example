# ── Backend ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
# SECRET_KEY=change-me-to-a-random-secret
# DATABASE_URL=postgresql+psycopg://todos_user:todos_pass@pgbouncer:5432/todos_app
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
# OAUTH_REDIRECT_BASE=http://localhost:8000
# FRONTEND_URL=http://localhost:3001
# DEBUG=true

# ── OAuth Credentials (leave empty to disable) ──
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Frontend (for local dev, also set in frontend/.env.local) ──
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
