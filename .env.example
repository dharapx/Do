# Backend
DATABASE_URL=postgresql+psycopg://todos_user:todos_pass@localhost:5432/todos_app
# For Docker: postgresql+psycopg://todos_user:todos_pass@postgres:5432/todos_app

SECRET_KEY=change-me-to-a-random-secret

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend port (used by docker-compose)
FRONTEND_PORT=3000
