# Backend
DATABASE_URL=postgresql+psycopg://todos_user:todos_pass@pgbouncer:6432/todos_app
# For local development: postgresql+psycopg://todos_user:todos_pass@localhost:5432/todos_app

REDIS_URL=redis://redis:6379/0
# For local development: redis://localhost:6379/0

SECRET_KEY=change-me-to-a-random-secret
# In production, use Docker secrets instead: echo "your-secret" > backend/secrets/secret_key.txt

# OAuth — set these in Docker secrets in production
# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App
# Callback URL: http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=placeholder-github-oauth-client-id
GITHUB_CLIENT_SECRET=placeholder-github-oauth-client-secret

# Google: Google Cloud Console > APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Callback URL: http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=placeholder-google-oauth-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-oauth-client-secret

# Base URL for OAuth callbacks (derives dynamic redirect targets)
OAUTH_REDIRECT_BASE=http://localhost:8000

# Frontend URL for OAuth redirects after callback
FRONTEND_URL=http://localhost:3001

# OAuth enable flags (unset = auto-detect from credentials)
# ENABLE_GITHUB_OAUTH=false
# ENABLE_GOOGLE_OAUTH=true

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# Auth token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie domain (set for subdomain sharing; leave empty for default)
# COOKIE_DOMAIN=.example.com

# Debug mode (insecure cookies, relaxed validation)
# DEBUG=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend port (used by docker-compose)
FRONTEND_PORT=3000
